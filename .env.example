# Optional read-only MCP option-chain provider.
# Leave disabled unless the exact upstream source and its automated-use terms
# have been reviewed and approved. MCP is a transport, not a data entitlement.
MCP_PROVIDER_ENABLED=false
MCP_AUTOMATED_USE_PERMITTED=false
# Example only: set to the local command that starts your reviewed MCP server.
# India Market MCP candidate (unofficial NSE website endpoints; disabled unless permitted).
# Requires uv/uvx installed in the same environment.
MCP_SERVER_COMMAND=uvx
MCP_SERVER_ARGS=--from git+https://github.com/kcodweb/india-market-mcp india-market-mcp
# Must exactly match the reviewed read-only tool.
MCP_OPTION_CHAIN_TOOL=get_option_chain
# This tool returns compact chain rows; the adapter normalizes them.
MCP_OPTION_CHAIN_ARGS_JSON={"symbol":"NIFTY","expiry":"nearest","strikes_each_side":50,"rate_pct":6.5}
MCP_TIMEOUT_SECONDS=15
MCP_POLL_INTERVAL_SECONDS=5
MCP_MAX_AGE_SECONDS=30
