# Optional read-only MCP option-chain provider.
# Leave disabled unless the exact upstream source and its automated-use terms
# have been reviewed and approved. MCP is a transport, not a data entitlement.
MCP_PROVIDER_ENABLED=false
MCP_AUTOMATED_USE_PERMITTED=false
# Example only: set to the local command that starts your reviewed MCP server.
MCP_SERVER_COMMAND=
MCP_SERVER_ARGS=
# Must exactly match one read-only tool exposed by that MCP server.
MCP_OPTION_CHAIN_TOOL=
# JSON object passed to the selected tool. Do not put secrets here.
MCP_OPTION_CHAIN_ARGS_JSON={}
MCP_TIMEOUT_SECONDS=15
